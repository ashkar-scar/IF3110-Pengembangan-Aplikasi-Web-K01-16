DATABASE_URL=postgres://platform:platform_dev@127.0.0.1:54329/platform?sslmode=disable
APP_ENV=development
APP_ADDR=:8080
DATA_DIR=.local/data
TEST_TARGET_DSN=postgres://target_user:target_dev@127.0.0.1:54329/target_test?sslmode=disable
TEST_PLATFORM_DSN=postgres://platform:platform_dev@127.0.0.1:54329/platform_test?sslmode=disable
# setup-local.ps1 generates these values when empty. Keep the encryption key stable.
TARGET_CREDENTIAL_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
DEMO_PASSWORD=
# Kosong memilih concurrency otomatis sesuai kapasitas pool, maksimal 4.
WORKER_CONCURRENCY=
WORKER_METRICS_ADDR=127.0.0.1:9091
# Isi endpoint ketika stack observability dijalankan; kosong memakai console traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
